# Copy to .env and fill in outside of Git. .env is ignored.
# AKF_DEV=1 loads the obvious dev tokens from examples/banking/config.yaml.
# Do not set AKF_DEV in any shared or production environment.

AKF_CONFIG=examples/banking/config.yaml
AKF_HTTP_ADDR=:8080
AKF_DEV=

# API role. Not a superuser. Not BYPASSRLS.
AKF_DATABASE_URL=postgres://akf_app:akf@127.0.0.1:5432/akf?sslmode=disable

# Migrations and workspace creation only. Do not point the request path at this URL.
AKF_INSTALLER_DATABASE_URL=postgres:///akf?host=/var/run/postgresql&sslmode=disable

AKF_AGENT_TOKEN=
AKF_CURATOR_TOKEN=

# Optional. Tests do not need these.
GITHUB_READONLY_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=
# Opt-in live GitHub App CI: set repository variable RUN_GITHUB_SANDBOX=true
# and secrets GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, GITHUB_APP_PRIVATE_KEY, and GITHUB_WEBHOOK_SECRET.
# The publisher reads owner and repo from workspace.knowledge_owner and
# workspace.knowledge_repo. These two variables override that config.
GITHUB_KNOWLEDGE_OWNER=
GITHUB_KNOWLEDGE_REPO=
# Protected branch. Overrides workspace.default_branch. Defaults to main.
AKF_DEFAULT_BRANCH=main
# Overrides workspace.knowledge_root.
AKF_KNOWLEDGE_ROOT=

# Optional model provider. The demo loop uses the deterministic curator when this is empty.
AKF_MODEL_BASE_URL=
AKF_MODEL_API_KEY=
AKF_MODEL_NAME=

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=knowledge-curator
# How often the worker's curation schedule runs. Go duration. Default 24h.
CURATION_INTERVAL=24h
# fts (default) or hybrid. hybrid reranks full-text hits locally.
# docs/sql/pgvector.sql is optional and is not applied automatically.
SEARCH_MODE=fts
# Optional Temporal Cloud credentials. Leave them empty for local Temporal.
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=
TEMPORAL_TLS_CA=
TEMPORAL_TLS_SERVER_NAME=
