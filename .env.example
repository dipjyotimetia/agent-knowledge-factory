# Copy to .env and fill in outside of Git. .env is ignored.
# AKF_DEV=1 loads the obvious dev tokens from examples/banking/config.yaml.
# Do not set AKF_DEV in any shared or production environment.

AKF_CONFIG=examples/banking/config.yaml
AKF_HTTP_ADDR=:8080
AKF_DEV=

# API role. Not a superuser. Not BYPASSRLS.
AKF_DATABASE_URL=postgres://akf_app:akf@127.0.0.1:5432/akf?sslmode=disable

# Migrations and workspace creation only. Do not point the request path at this URL.
AKF_INSTALLER_DATABASE_URL=postgres:///akf?host=/var/run/postgresql&sslmode=disable

AKF_AGENT_TOKEN=
AKF_CURATOR_TOKEN=

# Optional. Tests do not need these.
GITHUB_READONLY_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Opt-in live GitHub App CI: set repository variable RUN_GITHUB_SANDBOX=true
# and secrets GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, GITHUB_APP_PRIVATE_KEY.
GITHUB_KNOWLEDGE_OWNER=
GITHUB_KNOWLEDGE_REPO=

# Optional model provider. The demo loop uses the deterministic curator when this is empty.
AKF_MODEL_BASE_URL=
AKF_MODEL_API_KEY=
AKF_MODEL_NAME=

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
